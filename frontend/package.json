{
  "name": "the-frappe-docs-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-content.mjs && react-router dev",
    "build": "node scripts/build-sources.mjs",
    "typecheck": "node scripts/prepare-content.mjs && react-router typegen && tsc",
    "lint": "eslint app scripts *.ts --ext .ts,.tsx,.mjs",
    "test": "node --experimental-strip-types --test scripts/test-desk-links.mjs scripts/test-desk-excalidraw.mjs scripts/test-source-components.mjs && node scripts/check-build.mjs"
  },
  "dependencies": {
    "@react-router/node": "7.18.5",
    "@the-docs/core": "0.0.1-alpha.7",
    "@the-docs/plugin-bpmn": "0.0.1-alpha.7",
    "@the-docs/plugin-data-table": "0.0.1-alpha.7",
    "@the-docs/plugin-excalidraw": "0.0.1-alpha.7",
    "@the-docs/plugin-mermaid": "0.0.1-alpha.7",
    "@the-docs/plugin-syntax-highlighter": "0.0.1-alpha.7",
    "@the-docs/preset-default": "0.0.1-alpha.4",
    "clsx": "^2.1.1",
    "isbot": "^5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "7.18.5"
  },
  "devDependencies": {
    "@react-router/dev": "7.18.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7",
    "eslint-plugin-react-hooks": "^7",
    "typescript": "^6",
    "vite": "8.3.8"
  },
  "overrides": {
    "react-router": "$react-router",
    "@react-router/dev": "$@react-router/dev"
  }
}
